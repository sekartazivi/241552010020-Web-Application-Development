generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  nama      String
  harga     Int
  stok      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}